# SwordNex Academy Environment Configuration

# Gemini AI API Key for Video Doubt Assistant
# Store your official Google Gemini API key securely here on the backend.
# The server will automatically load GEMINI_API_KEY.
GEMINI_API_KEY=

# Optional: Gemini Model (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional YouTube Data API Key for dynamic video retrieval
# VITE_YOUTUBE_API_KEY=
